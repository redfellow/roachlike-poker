# Unique image tag for each release; retain the previous tag for rollback.
TORAKKA_RELEASE=dev
# Windows Nginx and SSH forwarding connect to this loopback port.
TORAKKA_HTTP_PORT=18889
# Required only for compose.registry.yaml; choose a version tag or digest.
# TORAKKA_IMAGE=ghcr.io/redfellow/roachlike-poker:dev-<full-commit-sha>
