{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [
			"node",
			"vitest/globals"
		],
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": [
		"apps",
		"packages",
		"tests",
		"*.ts",
		"ops/**/*.ts"
	]
}
